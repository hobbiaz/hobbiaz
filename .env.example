# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL. Neon: DATABASE_URL = the *pooled* connection string, DIRECT_URL = the direct one.
# Locally both can be the same string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hobbi_az?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hobbi_az?sslmode=require"
# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_PLUS_CHARS"
# Public site origin (used for same-origin checks, sitemap, OG links)
APP_ORIGIN="http://localhost:3000"

# ─── E-mail (OTP codes, order notices) — Resend ────────────────────────────
# Without these, in development the code is shown in the UI/console; in production sign-up won't work.
RESEND_API_KEY=""
EMAIL_FROM="hobbi.az <noreply@hobbi.az>"
# Address the "Dəstək" form opens in the mail app
NEXT_PUBLIC_SUPPORT_EMAIL="destek@hobbi.az"

# ─── Image storage — Cloudflare R2 (required on Vercel) ────────────────────
# Without these, uploads go to UPLOAD_DIR on local disk (fine for development only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hobbi-media"
UPLOAD_DIR="./uploads"

# ─── Rate limiting — Upstash Redis (recommended in production) ─────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Seed (npm run db:seed) ────────────────────────────────────────────────
# Password for the demo stores/buyer. Admin is created only if both admin vars are set.
SEED_DEMO_PASSWORD="CHANGE_ME_demo_password"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional: public video URL for a demo reel (none ships with the repo)
SEED_DEMO_REEL_URL=""
