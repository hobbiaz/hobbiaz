generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL = pooled connection, DIRECT_URL = direct one (used by migrations).
  // Locally both can be the same string.
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  REMOVED
}

enum Condition {
  NEW
  USED
  HANDMADE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum OtpPurpose {
  SIGNUP
  RESET
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}


model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  city         String?
  bio          String?
  avatarUrl    String?
  role         Role     @default(BUYER)
  isDemo       Boolean  @default(false)
  emailVerifiedAt DateTime?
  /// The notifications menu shows items newer than this as unread.
  notificationsSeenAt DateTime?
  createdAt    DateTime @default(now())

  store         Store?
  reviews       Review[]
  ordersPlaced  Order[]    @relation("buyer")
  ordersReceived Order[]   @relation("seller")
  listings      Listing[]  @relation("owner")
  favorites     Favorite[]
  participants  ConversationParticipant[]
  messages      Message[]
  reels         Reel[]
  reelLikes     ReelLike[]
  reelComments  ReelComment[]
  reports       Report[]   @relation("reporter")
  uploads       Upload[]
  collections   Collection[]
}

/// A seller's shop ("mağaza"), created by the onboarding wizard.
model Store {
  id           String   @id @default(cuid())
  ownerId      String   @unique
  name         String   @unique
  slug         String   @unique
  categorySlug String
  region       String   @default("Bakı")
  avatarUrl    String?
  bio          String?
  phone        String?
  instagram    String?
  tiktok       String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// One-time e-mail codes for sign-up and password reset. Only a hash of the code is stored.
model OtpCode {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  @@index([email, purpose, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  listings Listing[]
}

model Listing {
  id            String        @id @default(cuid())
  ownerId       String
  categoryId    String
  title         String
  description   String
  priceCents    Int
  condition     Condition     @default(NEW)
  city          String
  status        ListingStatus @default(DRAFT)
  removedReason String?
  moderatedById String?
  moderatedAt   DateTime?
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  oldPriceCents Int?
  phone         String?

  owner    User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  images   ListingImage[]
  reviews  Review[]
  orders   Order[]
  favorites Favorite[]
  reports  Report[]
  conversations Conversation[]
  collections   CollectionItem[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([ownerId])
  @@index([priceCents])
}

model Upload {
  key       String   @id
  ownerId   String
  mime      String
  size      Int
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images    ListingImage[]
  @@index([ownerId])
}

model ListingImage {
  id         String  @id @default(cuid())
  listingId  String
  /// Uploaded file (our storage) …
  storageKey String?
  /// … or an absolute external URL (demo data).
  url        String?
  position   Int     @default(0)
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  upload     Upload? @relation(fields: [storageKey], references: [key])
  @@index([listingId, position])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@id([userId, listingId])
}

model Conversation {
  id           String   @id @default(cuid())
  listingId    String?
  createdAt    DateTime @default(now())
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  /// Messages after this moment count as unread for this participant.
  lastReadAt     DateTime?
  /// "Delete chat" for this participant only: the chat and its older messages are hidden from them;
  /// a newer message brings the chat back (showing only what came after).
  hiddenAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Reel {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  videoUrl  String
  posterUrl String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  likes     ReelLike[]
  comments  ReelComment[]
  @@index([createdAt])
}

model ReelLike {
  userId String
  reelId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel   Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  @@id([userId, reelId])
}

model ReelComment {
  id        String   @id @default(cuid())
  reelId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  reel      Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([reelId, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User    @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([listingId, reporterId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  rating    Int      @default(5)
  body      String
  reply     String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([listingId, userId])
  @@index([listingId, createdAt])
}

/// "Sifariş et": a buyer's order request for one listing; the seller accepts or rejects it.
model Order {
  id         String      @id @default(cuid())
  listingId  String?
  buyerId    String
  sellerId   String
  title      String
  priceCents Int
  quantity   Int         @default(1)
  phone      String?
  note       String?
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer      User        @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller     User        @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  @@index([buyerId, createdAt])
  @@index([sellerId, status, createdAt])
}

/// A user-made collection ("Kolleksiya yarat"): 8–20 hand-picked listings, visible to everyone.
model Collection {
  id        String           @id @default(cuid())
  ownerId   String
  title     String
  createdAt DateTime         @default(now())
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     CollectionItem[]

  @@index([createdAt])
  @@index([ownerId])
}

model CollectionItem {
  collectionId String
  listingId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([collectionId, listingId])
  @@index([listingId])
}

/// How often a search text was used — feeds "Ən çox axtarılanlar" in the search panel.
model SearchTerm {
  term      String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count])
}
