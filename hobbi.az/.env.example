# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hobbi_az?schema=public"
# Random string, 32+ chars (e.g. `openssl rand -base64 48`)
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_PLUS_CHARS"
# Public site origin, used for same-origin checks on mutating requests
APP_ORIGIN="http://localhost:3000"
# Local upload dir (development). For production implement S3Storage, see README
UPLOAD_DIR="./uploads"
# Seed only: password for demo users. Admin is created only if both are set.
SEED_DEMO_PASSWORD="CHANGE_ME_demo_password"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional: public video URL for the demo reel (none ships with the repo)
SEED_DEMO_REEL_URL=""
