# ─── Own server (Docker) — copy to .env.production and fill in. Never commit .env.production. ───
# Used by: docker compose --env-file .env.production up -d --build   (see HOSTING.md)

# Domain that points at this server (A record → server IP). Used for HTTPS (Caddy).
DOMAIN="hobbi.az"
# Public address of the site.
APP_ORIGIN="https://hobbi.az"

# Database password for the bundled PostgreSQL (long and random; letters and digits only).
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD="CHANGE_ME"
# DATABASE_URL / DIRECT_URL are set by docker-compose.yml from POSTGRES_PASSWORD.
# To use an external database instead (Neon, managed PostgreSQL), see HOSTING.md.

# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_PLUS_CHARS"

# E-mail (OTP codes) — Resend. Without it sign-up does not work in production.
RESEND_API_KEY=""
EMAIL_FROM="hobbi.az <noreply@hobbi.az>"
# Shown on the "Dəstək" form (baked in when the image is built).
NEXT_PUBLIC_SUPPORT_EMAIL="destek@hobbi.az"

# Photos & videos: leave R2_* empty to keep them on this server (Docker volume "uploads"),
# or fill them in to use Cloudflare R2 (recommended: files then survive a server move untouched).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hobbi-media"

# Optional: Upstash Redis for rate limits (needed only with more than one app container).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
